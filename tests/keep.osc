# our typical overtake (exp_002_b) but using the keep structure 
#  (i.e. enforcing it as an invariant on the OS2 level)
#
# The final gap is 13m..25m instead of exp_002_b's 5m..10m. With car1 held in its lane, merging
# back in front of it needs at least min_change_speed + safety_distance_back = 6 + 7 = 13m, so
# 5m..10m cannot be met. See keep_scenario_scope.osc for the full derivation.

scenario overtake:
    car1: car
    ego: car

    do parallel(duration:  [3s..20s]):

        c0: car1.drive() with:
            keep(car1.lane==2)

        c1: serial:
            A: ego.drive() with:
                lane(same_as:car1, at:start)
                lane(left_of:car1, at:end)
                position([10m..20m], behind:car1, at:start)

            B: ego.drive() with:
                position([1m..10m], ahead_of:car1, at:end)

            C: ego.drive() with:
                lane(same_as: car1, at: end)
                position([13m..25m], ahead_of: car1, at: end)