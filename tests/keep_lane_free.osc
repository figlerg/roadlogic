# Constant lane without hardcoding the value. This is the desugared form of the domain model's
# keep_lane() modifier: a parameter is introduced, the actor's lane is kept equal to it, and
# because a parameter holds one value for the lifetime of its instance the effect is exactly
# "the lane never changes" with the concrete value left to constraint resolution.
# This is the form we actually want. keep_scenario_scope.osc is the hardcoded stand-in.

scenario overtake:
    car1: car
    ego: car
    car1_lane: int

    keep(car1.lane == car1_lane)

    do parallel(duration:  [3s..20s]):

        c0: car1.drive()

        c1: serial:
            A: ego.drive() with:
                lane(same_as:car1, at:start)
                lane(left_of:car1, at:end)
                position([10m..20m], behind:car1, at:start)

            B: ego.drive() with:
                position([1m..10m], ahead_of:car1, at:end)
