# car1 starts 10m to 20m behind car2 and has to end 5m to 10m ahead of it. With a generous 20s
# this is satisfiable. Same spec as duration_max_unsat.osc apart from the duration, so if that
# one is rejected the duration is the only reason.

scenario pass_in_time:
    car1: car
    car2: car

    do parallel(duration: [1s..20s]):
        c0: car2.drive() with:
            lane(1, at: start)
            position(50m, at: start)
        c1: car1.drive() with:
            lane(same_as: car2, at: start)
            position([10m..20m], behind: car2, at: start)
            position([5m..10m], ahead_of: car2, at: end)
