# Negative test, must be UNSAT. This is verbatim the standard's own example from 7.6.2.3:
# keep(speed>10mps) together with keep(speed<10mps) on the same vehicle actor.

scenario overtake:
    car1: car
    ego: car

    keep(car1.speed > 10mps)
    keep(car1.speed < 10mps)

    do parallel(duration:  [3s..20s]):

        c0: car1.drive()

        c1: serial:
            A: ego.drive() with:
                lane(same_as:car1, at:start)
                position([10m..20m], behind:car1, at:start)

            B: ego.drive() with:
                position([1m..10m], ahead_of:car1, at:end)
