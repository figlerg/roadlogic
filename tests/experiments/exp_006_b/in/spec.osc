# 2 cars behind each other. one moves to other lane, then other moves to other lane


scenario follow:
    car1: car
    ego: car

    do parallel(duration:  [3s..20s]):

        c0: car1.drive()

        c1: ego.drive() with:
            position([10m..20m], behind:car1, at:start)
            lane(same_as:car1, at:start)
            lane(left_of:car1, at:end)

