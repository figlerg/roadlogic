# Exact duration. A single value instead of a range pins the last goal time to exactly 5.

scenario exact_duration:
    car1: car
    car2: car

    do parallel(duration: 5s):
        c0: car1.drive() with:
            lane(1, at: start)
            position(0m, at: start)
        c1: car2.drive() with:
            lane(same_as: car1, at: start)
            position([10m..20m], ahead_of: car1, at: start)
