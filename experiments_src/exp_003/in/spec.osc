# our typical overtake, but this time with a third actor in parallel

scenario overtake:
    p: path
    car1: car
    ego: car
    car2: car

    do parallel(duration:  [3s..20s]):

        parallel:
            c0: car1.drive(p)

            c1: serial:
                A: ego.drive(p) with:
                    lane(same_as:car1, at:start)
                    lane(left_of:car1, at:end)
                    position([10m..20m], behind:car1, at:start)

                B: ego.drive() with:
                    position([1m..10m], ahead_of:car1, at:end)

                C: ego.drive() with:
                    lane(same_as: car1, at: end)
                    position([5m..10m], ahead_of: car1, at: end)
        
        c2: car2.drive(p) with:
            lane(same_as:ego, at:start)
            position([25m..30m], ahead_of:ego, at:start)