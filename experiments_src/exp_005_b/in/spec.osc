# our typical overtake, but there is a static obstacle

scenario overtake:
    car1: car
    ego: car
    obstacle: car

    do parallel(duration:  [3s..20s]):

        parallel:
            c0: car1.drive()

            c1: serial:
                A: ego.drive() with:
                    lane(same_as:car1, at:start)
                    lane(left_of:car1, at:end)
                    position([10m..20m], behind:car1, at:start)

                B: ego.drive() with:
                    position([1m..10m], ahead_of:car1, at:end)

                C: ego.drive() with:
                    lane(same_as: car1, at: end)
                    position([30m..40m], ahead_of: car1, at: end)
        
        c2: obstacle.drive() # right now we load these as cars